{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wyrd Diff",
  "version": "0.1.0",
  "identifier": "ai.wyrd.diff",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Wyrd Diff",
        "width": 1280,
        "height": 820
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Local diff review for coding agents",
    "longDescription": "Wyrd Diff pipes reviewer feedback back to the coding agent while it is still in session.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.png"],
    "targets": ["app", "dmg", "deb", "appimage"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
